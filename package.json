{
  "name": "pg-wfh-notifier",
  "version": "1.0.0",
  "description": "Telegram notifier that announces Work From Home when the Penang haze (API) reading crosses a threshold",
  "type": "module",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "once": "node src/index.js --once",
    "subs": "node src/index.js --subs",
    "allowlist": "node src/index.js --allowlist",
    "msg:wfh": "node src/index.js --send-test wfh",
    "msg:wfo": "node src/index.js --send-test wfo",
    "msg:welcome": "node src/index.js --send-test welcome",
    "msg:status": "node src/index.js --send-test status",
    "msg:trend": "node src/index.js --send-test trend",
    "test": "node --test"
  },
  "engines": {
    "node": ">=23.4.0"
  },
  "dependencies": {
    "node-cron": "^4.0.0"
  }
}
